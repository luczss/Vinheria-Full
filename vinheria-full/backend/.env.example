# ============================================================================
# CONFIGURAÇÕES PERSONALIZÁVEIS  —  copie este arquivo:  .env.example -> .env
# ============================================================================
# Tudo que muda entre ambientes está aqui. NENHUM IP/porta/chave fica no código.
# Linhas marcadas com [ALTERAR] dependem do SEU ambiente FIWARE.

# --- Backend ----------------------------------------------------------------
# Porta HTTP do backend Node.js
PORT=3000
# development | production (em production a API não devolve stack trace)
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=info
# Origem permitida no CORS (URL do React, ex.: http://localhost:5173). * libera tudo.
CORS_ORIGIN=*
# Timeout (ms) das chamadas HTTP para Orion / IoT Agent / STH-Comet
REQUEST_TIMEOUT_MS=8000

# --- Endereço do servidor FIWARE, visto a partir do BACKEND  [ALTERAR] --------
# O IP da VM muda quando ela é religada? Edite SOMENTE esta linha.
# Deriva: ORION_URL=http://HOST:1026, IOTA_URL=http://HOST:4041, STH_URL=http://HOST:8666,
#         MQTT_BROKER_URL=mqtt://HOST:1883.  Vazio = localhost.
FIWARE_HOST=
# Opcional — sobrescrevem o FIWARE_HOST (use se as portas forem diferentes ou os serviços estiverem em máquinas distintas):
# ORION_URL=http://localhost:1026
# IOTA_URL=http://localhost:4041
# STH_URL=http://localhost:8666
# MQTT_BROKER_URL=mqtt://localhost:1883

# --- Multi-tenancy / identificação FIWARE ------------------------------------
# Cabeçalhos fiware-service / fiware-servicepath enviados em todas as chamadas
FIWARE_SERVICE=smart
FIWARE_SERVICEPATH=/
# API key do service group do IoT Agent (primeiro segmento do tópico MQTT: /TEF/<device>/attrs)
FIWARE_APIKEY=TEF
# Tipo NGSI das entidades
FIWARE_ENTITY_TYPE=VinheriaDevice
# Entidade = ENTITY_URN_PREFIX + deviceId sem o prefixo DEVICE_ID_PREFIX
# vinheria001 -> urn:ngsi-ld:VinheriaDevice:001
ENTITY_URN_PREFIX=urn:ngsi-ld:VinheriaDevice:
DEVICE_ID_PREFIX=vinheria

# --- Endereços FIWARE, vistos entre os próprios containers FIWARE  [ALTERAR] --
# Valores conferidos no docker-compose.yml do professor (serviços: orion, iot-agent, fiware-sth-comet).
# Alternativa usada na Postman Collection: o IP público para tudo (ex.: http://18.232.xxx.xxx:8666/notify).
# Estes valores NÃO são os mesmos de cima quando o backend roda fora do Docker:
# aqui vale o nome/IP que um container enxerga o outro.
# Como o IoT Agent enxerga o Orion (campo cbroker do service group)
ORION_URL_FOR_IOTA=http://orion:1026
# Como o Orion enxerga o IoT Agent (provider do POST /v2/registrations)
IOTA_URL_FOR_ORION=http://iot-agent:4041
# Como o Orion enxerga o STH-Comet (URL de notificação da subscription de histórico)
STH_NOTIFY_URL=http://fiware-sth-comet:8666/notify
# Identificador (prefixo da description) das subscriptions do STH-Comet criadas pelo backend
STH_SUBSCRIPTION_ID=vinheria-full-sth-subscription

# --- Opcional: notificações do Orion para o backend --------------------------
# URL pela qual o ORION alcança este backend (ex.: http://IP_DA_SUA_MAQUINA:3000).
# Vazio = não cria subscription; o motor de alertas usa apenas polling (padrão).
BACKEND_PUBLIC_URL=

# --- Motor de alertas ---------------------------------------------------------
ALERT_POLL_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=10
# Máximo de eventos de alerta guardados por dispositivo
ALERT_LOG_SIZE=50

# Triggers padrão aplicados a todo dispositivo novo (o frontend pode alterar depois)
TRIGGER_DEFAULT_TEMPERATURE_ENABLED=true
TRIGGER_DEFAULT_TEMPERATURE_MIN=10
TRIGGER_DEFAULT_TEMPERATURE_MAX=25
TRIGGER_DEFAULT_TEMPERATURE_HYSTERESIS=0
TRIGGER_DEFAULT_HUMIDITY_ENABLED=true
TRIGGER_DEFAULT_HUMIDITY_MIN=40
TRIGGER_DEFAULT_HUMIDITY_MAX=70
TRIGGER_DEFAULT_HUMIDITY_HYSTERESIS=0
TRIGGER_DEFAULT_LUMINOSITY_ENABLED=true
TRIGGER_DEFAULT_LUMINOSITY_MIN=20
TRIGGER_DEFAULT_LUMINOSITY_MAX=80
TRIGGER_DEFAULT_LUMINOSITY_HYSTERESIS=0

# --- Dispositivos / histórico --------------------------------------------------
# Sem telemetria há mais que isso => status "offline"
DEVICE_ONLINE_TIMEOUT_SECONDS=120
# Pontos devolvidos por padrão no histórico (lastN) e máximo permitido
HISTORY_DEFAULT_LAST_N=50
HISTORY_MAX_POINTS=100
